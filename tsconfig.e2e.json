{
  // The e2e tests run in Node, but the callbacks they pass to `evaluate` run in the
  // browser, so they need the DOM types too. Kept apart so the Node configs don't get them.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["e2e"]
}
